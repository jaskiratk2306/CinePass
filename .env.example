# Database Connection (local postgres or Neon connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cinema_booking?schema=public"

# Test Database Connection (optional override for testing)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/cinema_booking_test?schema=public"

# Server Port
PORT=4000

# Node Environment
NODE_ENV=development

# JWT Secret & Expiry
JWT_SECRET="super-secret-jwt-key-for-cinema-booking-change-in-prod"
JWT_EXPIRES_IN="7d"

# Business Rules Configuration
HOLD_TTL_MINUTES=5
CANCEL_CUTOFF_HOURS=2
MAX_SEATS_PER_HOLD=8

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
